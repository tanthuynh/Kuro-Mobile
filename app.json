{
  "expo": {
    "name": "Kuro Mobile",
    "slug": "kuro-mobile",
    "version": "0.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kuromobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#141414"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amiastudios.kuromobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Kuro Mobile tracks your location during active logistics jobs to provide dispatchers with real-time ETA and status updates.",
        "NSLocationWhenInUseUsageDescription": "Kuro Mobile uses your location to show nearby stops and provide accurate route navigation.",
        "NSCameraUsageDescription": "Kuro Mobile uses your camera to scan equipment barcodes and QR codes for warehouse pull sheets."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#141414"
      },
      "package": "com.amiastudios.kuromobile",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Kuro Mobile uses your camera to scan equipment barcodes and QR codes for warehouse pull sheets."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Calibri.ttf",
            "./assets/fonts/Calibri-Regular.ttf",
            "./assets/fonts/Calibri-Bold.ttf",
            "./assets/fonts/Calibri-Italic.ttf",
            "./assets/fonts/Calibri-BoldItalic.ttf",
            "./assets/fonts/Calibri-Light.ttf"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Kuro Mobile tracks your location during active logistics jobs to provide dispatchers with real-time ETA and status updates."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
